# ─────────────────────────────────────────────────────────────
#  Consultorio Legal — Variables de Entorno
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/consultorio_legal
POSTGRES_DB=consultorio_legal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_password

# ── Cache / Broker ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Seguridad ─────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_min_32_chars

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pagos — Wompi (Colombia) ──────────────────────────────────
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Notificaciones — Twilio (WhatsApp / SMS) ──────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Correo — SendGrid ─────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Cloud Storage ──────────────────────────────────────
GCS_BUCKET_NAME=consultorio-legal-docs
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── PgAdmin ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@consultorio.local
PGADMIN_PASSWORD=pgadmin_password
